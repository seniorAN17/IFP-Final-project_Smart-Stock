@* BLOCK 1. Page settings: address /products, live mode, only for logged-in users, and the service that works with products, categories and suppliers *@
@page "/products"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IInventoryService Inventory

<PageTitle>Products · SmartStock</PageTitle>
@* BLOCK 2. ON THE SITE: title "Products" with the grey text and the "+ Add product" button at the top right *@
<PageHeader Title="Products" Description="Manage product details, prices and stock levels.">
    <Actions><button class="btn-primary" @onclick="OpenNew">＋ Add product</button></Actions>
</PageHeader>
@* BLOCK 3. ON THE SITE: the search box and the counter "N products". The list filters while you type (oninput) *@
<div class="toolbar"><input class="search" placeholder="Search by product name or SKU…" @bind="search" @bind:event="oninput" /><span class="result-count">@filtered.Count products</span></div>
@* BLOCK 4. ON THE SITE: the notice bar with "Product saved successfully.", "Product deleted." or an error from the service *@
@if (!string.IsNullOrWhiteSpace(message)) { <div class="notice">@message</div> }
@* BLOCK 5. ON THE SITE: the form panel for a new or an existing product. It is hidden until showForm is true.
   Fields: name, SKU, price, quantity, reorder level, category, supplier.
   When a product is edited, Quantity is disabled, so stock changes only on the Transactions page *@
@if (showForm)
{
    <section class="panel form-panel">
        <h2>@(editing.Id == 0 ? "Add product" : "Edit product")</h2>
        <EditForm Model="editing" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <label>Product name<InputText @bind-Value="editing.Name" /></label>
                <label>SKU<InputText @bind-Value="editing.SKU" /></label>
                <label>Unit price<InputNumber @bind-Value="editing.UnitPrice" /></label>
                <label>Quantity<InputNumber @bind-Value="editing.Quantity" disabled="@(editing.Id != 0)" /></label>
                <label>Reorder level<InputNumber @bind-Value="editing.ReorderLevel" /></label>
                <label>Category<InputSelect @bind-Value="editing.CategoryId"><option value="">No category</option>@foreach (var c in categories) { <option value="@c.Id">@c.Name</option> }</InputSelect></label>
                <label>Supplier<InputSelect @bind-Value="editing.SupplierId"><option value="">No supplier</option>@foreach (var s in suppliers) { <option value="@s.Id">@s.Name</option> }</InputSelect></label>
            </div>
            @if (editing.Id != 0) { <p class="muted form-hint">Stock quantity can only be changed on the Transactions page, so the history stays accurate.</p> }
            <div class="form-actions"><button class="btn-primary" type="submit">Save product</button><button class="btn-secondary" type="button" @onclick="CloseForm">Cancel</button></div>
        </EditForm>
    </section>
}
@* BLOCK 6. ON THE SITE: the products table. The header row has 7 columns.
   Below it, one row for each product from the filtered list: name, SKU, category, price in dollars,
   quantity, colored status badge, and the Edit button. The Delete button is shown only to Admin.
   If nothing is found, the text "No products found" appears under the table *@
<div class="table-wrap"><table><thead><tr><th>Product</th><th>SKU</th><th>Category</th><th>Price</th><th>Quantity</th><th>Status</th><th>Actions</th></tr></thead>
<tbody>
@foreach (var p in filtered)
{
    <tr><td><b>@p.Name</b></td><td class="code">@p.SKU</td><td>@(p.Category?.Name ?? "—")</td><td>@p.UnitPrice.ToString("C", CultureInfo.GetCultureInfo("en-US"))</td><td>@p.Quantity</td><td><StockStatusBadge Quantity="p.Quantity" ReorderLevel="p.ReorderLevel" /></td><td><button class="link-button" @onclick="() => Edit(p)">Edit</button><AuthorizeView Roles="Admin"><button class="link-button danger-text" @onclick="() => Delete(p.Id)">Delete</button></AuthorizeView></td></tr>
}
</tbody></table>
@if (filtered.Count == 0) { <div class="empty-state">No products found. Try another search or add a product.</div> }
</div>
@code {
    // BLOCK 7. Page data: the three lists from the database, the product in the form (editing),
    // the text in the search box, the notice text, and the flag "show the form".
    private List<Product> products = [];
    private List<Category> categories = [];
    private List<Supplier> suppliers = [];
    private Product editing = new();
    private string search = "";
    private string message = "";
    private bool showForm;
    // BLOCK 8. The search filter (LINQ with a lambda). If the search box is empty, all products are shown.
    // Otherwise it keeps products whose name or SKU contains the text, ignoring upper or lower case.
    private List<Product> filtered => products.Where(p => string.IsNullOrWhiteSpace(search) || p.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || p.SKU.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();
    // BLOCK 9. Loading: when the page opens, take products, categories and suppliers from the service
    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() { products = await Inventory.GetProductsAsync(); categories = await Inventory.GetCategoriesAsync(); suppliers = await Inventory.GetSuppliersAsync(); }
    // BLOCK 10. Form buttons: "+ Add product" opens an empty form, "Cancel" closes it,
    // "Edit" opens the form with a COPY of the product, so Cancel does not change the table
    private void OpenNew() { editing = new Product(); message = ""; showForm = true; }
    private void CloseForm() => showForm = false;
    private void Edit(Product p) { editing = new Product { Id=p.Id, Name=p.Name, SKU=p.SKU, UnitPrice=p.UnitPrice, Quantity=p.Quantity, ReorderLevel=p.ReorderLevel, CategoryId=p.CategoryId, SupplierId=p.SupplierId }; message=""; showForm=true; }
    // BLOCK 11. Save and Delete: the service checks the business rules (unique SKU, product in use).
    // On success the notice shows the result and the table reloads. On error the notice shows the service message.
    private async Task Save() { try { await Inventory.SaveProductAsync(editing); showForm=false; message="Product saved successfully."; await Load(); } catch(Exception ex) { message=ex.Message; } }
    private async Task Delete(int id) { try { await Inventory.DeleteProductAsync(id); message="Product deleted."; await Load(); } catch(Exception ex) { message=ex.Message; } }
}